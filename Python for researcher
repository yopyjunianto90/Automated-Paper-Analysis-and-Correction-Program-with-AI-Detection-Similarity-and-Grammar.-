def analyze_statistics(text):
    """
    Analisis statistik teks
    """
    stats = {
        'total_words': len(text.split()),
        'total_characters': len(text),
        'total_sentences': len(nltk.sent_tokenize(text)),
        'avg_word_length': np.mean([len(word) for word in text.split()]),
        'unique_words': len(set(text.split())),
    }

    # Hitung tingkat keragaman kosakata
    if stats['total_words'] > 0:
        stats['vocabulary_diversity'] = stats['unique_words'] / stats['total_words']
    else:
        stats['vocabulary_diversity'] = 0

    return stats

def generate_report(original_text, corrected_text, corrections, issues, stats, ai_analysis, similar_pairs):
    """
    Generate laporan lengkap dalam format DOCX
    """
    from docx import Document
    from docx.shared import Pt, RGBColor, Inches
    from docx.enum.text import WD_ALIGN_PARAGRAPH

    doc = Document()

    # Judul
    title = doc.add_heading('LAPORAN ANALISIS PAPER', 0)
    title.alignment = WD_ALIGN_PARAGRAPH.CENTER

    # Ringkasan
    doc.add_heading('Ringkasan Analisis', level=1)
    doc.add_paragraph(f'Total Kata: {stats["total_words"]}')
    doc.add_paragraph(f'Total Kalimat: {stats["total_sentences"]}')
    doc.add_paragraph(f'Kata Unik: {stats["unique_words"]}')
    doc.add_paragraph(f'Keragaman Kosakata: {stats["vocabulary_diversity"]:.3f}')
    doc.add_paragraph(f'Rata-rata Panjang Kata: {stats["avg_word_length"]:.2f}')

    # Analisis AI
    if ai_analysis:
        doc.add_heading('Analisis Penggunaan AI', level=1)
        doc.add_paragraph(f'Persentase Penggunaan AI: {ai_analysis["ai_percentage"]:.2f}%')
        doc.add_paragraph(f'Klasifikasi: {ai_analysis["classification"]}')

    # Koreksi kesalahan
    doc.add_heading('Koreksi Kesalahan', level=1)

    if corrections:
        table = doc.add_table(rows=len(corrections)+1, cols=3)
        table.style = 'Light Grid Accent 1'

        # Header
        hdr_cells = table.rows[0].cells
        hdr_cells[0].text = 'Jenis Kesalahan'
        hdr_cells[1].text = 'Sebelum'
        hdr_cells[2].text = 'Sesudah'

        for i, corr in enumerate(corrections, 1):
            row_cells = table.rows[i].cells
            row_cells[0].text = 'Typo/Grammar'
            row_cells[1].text = corr.get('original', '')
            row_cells[2].text = corr.get('corrected', '')

    # Isu Formatting
    if issues:
        doc.add_heading('Isu Formatting dan Gaya Penulisan', level=1)
        for issue in issues[:10]:  # Batasi 10 issue teratas
            doc.add_paragraph(
                f"• {issue.get('issue', '')}",
                style='List Bullet'
            )
            if 'suggestion' in issue:
                doc.add_paragraph(
                    f"  Saran: {issue['suggestion']}",
                    style='List Bullet'
                )

    # Similarity
    if similar_pairs:
        doc.add_heading('Analisis Similaritas', level=1)
        doc.add_paragraph(f'Total pasangan kalimat serupa: {len(similar_pairs)}')

        for pair in similar_pairs[:5]:  # Tampilkan 5 pasangan pertama
            doc.add_paragraph(f'Skor Similaritas: {pair["similarity_score"]:.2f}')
            doc.add_paragraph(f'Kalimat 1: {pair["sentence1"][:100]}...')
            doc.add_paragraph(f'Kalimat 2: {pair["sentence2"][:100]}...')
            doc.add_paragraph('')

    # Teks yang sudah dikoreksi
    doc.add_heading('Hasil Koreksi', level=1)
    doc.add_paragraph('Teks yang telah dikoreksi:')
    doc.add_paragraph(corrected_text)

    # Simpan
    output_file = 'hasil_koreksi_paper.docx'
    doc.save(output_file)
    return output_file

