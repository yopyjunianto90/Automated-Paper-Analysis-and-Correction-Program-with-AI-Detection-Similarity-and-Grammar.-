# 4. FUNGSI DETEKSI PENGGUNAAN AI
# ============================================

class AIDetector:
    def __init__(self):
        """
        Inisialisasi model untuk deteksi teks yang dihasilkan AI
        """
        print("🔧 Menginisialisasi model deteksi AI...")
        self.ai_detector = pipeline(
            "text-classification",
            model="roberta-base-openai-detector"
        )
        print("✅ Model deteksi AI siap digunakan")

    def detect_ai_usage(self, text):
        """
        Mendeteksi persentase teks yang mungkin dihasilkan AI
        """
        try:
            # Bagi teks menjadi beberapa bagian
            chunks = [text[i:i+512] for i in range(0, min(len(text), 10000), 512)]
            ai_scores = []

            for chunk in chunks:
                if len(chunk) > 50:
                    result = self.ai_detector(chunk[:512])
                    if result:
                        ai_scores.append(result[0]['score'] if result[0]['label'] == 'LABEL_1' else 1 - result[0]['score'])

            if ai_scores:
                avg_ai_score = np.mean(ai_scores)
                return {
                    'ai_percentage': avg_ai_score * 100,
                    'classification': 'High AI Usage' if avg_ai_score > 0.7 else 'Medium AI Usage' if avg_ai_score > 0.4 else 'Low AI Usage',
                    'confidence': avg_ai_score
                }

            return None
        except Exception as e:
            print(f"❌ Error deteksi AI: {e}")
            return None

