class TextCorrector:
    def __init__(self):
        """
        Inisialisasi berbagai tools untuk koreksi teks
        """
        print("🔧 Menginisialisasi tools koreksi...")
        self.spell_checker_en = SpellChecker(language='en')
        self.spell_checker_id = SpellChecker(language='id')
        self.lt = language_tool_python.LanguageTool('id-ID')
        self.lt_en = language_tool_python.LanguageTool('en-US')
        self.nlp_en = spacy.load('en_core_web_sm')
        self.nlp_id = spacy.load('pt_core_news_sm')
        self.translator = GoogleTranslator(source='auto', target='en') # Initialize with deep_translator

        print("✅ Tools koreksi siap digunakan")

    def check_typos(self, text, lang='id'):
        """
        Memeriksa dan memperbaiki typo
        """
        words = text.split()
        corrected_words = []
        corrections = []

        spell_checker = self.spell_checker_id if lang == 'id' else self.spell_checker_en

        for word in words:
            # Hapus tanda baca untuk pengecekan
            clean_word = word.strip(string.punctuation)

            if clean_word and len(clean_word) > 2:
                if clean_word.lower() not in spell_checker:
                    candidates = spell_checker.candidates(clean_word)
                    if candidates:
                        corrected = list(candidates)[0]
                        if corrected != clean_word:
                            corrections.append({
                                'original': clean_word,
                                'corrected': corrected,
                                'position': words.index(word)
                            })
                            word = word.replace(clean_word, corrected)

            corrected_words.append(word)

        return ' '.join(corrected_words), corrections

    def check_grammar(self, text, lang='id'):
        """
        Memeriksa dan memperbaiki grammar
        """
        tool = self.lt if lang == 'id' else self.lt_en
        matches = tool.check(text)
        corrections = []

        # Terapkan koreksi
        corrected_text = text
        for match in matches[:20]:  # Batasi untuk menghindari terlalu banyak perubahan
            if match.replacements:
                correction = {
                    'issue': match.message,
                    'suggestion': match.replacements[0],
                    'context': match.context,
                    'offset': match.offset,
                    'length': match.errorLength
                }
                corrections.append(correction)

                # Lakukan koreksi
                start = match.offset
                end = match.offset + match.errorLength
                if start < len(corrected_text) and end <= len(corrected_text):
                    corrected_text = corrected_text[:start] + match.replacements[0] + corrected_text[end:]

        return corrected_text, corrections

    def check_formatting(self, text):
        """
        Memeriksa format penulisan (italic, bold, dll)
        """
        issues = []

        # Cek kata asing yang seharusnya italic
        # (Deteksi sederhana untuk kata yang bukan dalam kamus umum)
        words = re.findall(r'\b[a-zA-Z]+\b', text)
        common_words = set(['the', 'be', 'to', 'of', 'and', 'a', 'in', 'that', 'have', 'i',
                           'it', 'for', 'not', 'on', 'with', 'he', 'as', 'you', 'do', 'at'])

        for word in words:
            if word.lower() not in common_words and len(word) > 3:
                issues.append({
                    'word': word,
                    'issue': 'Kata asing/tidak umum yang mungkin perlu dicetak miring',
                    'suggestion': f"*{word}*"
                })

        return issues

    def check_coherence(self, text):
        """
        Memeriksa koherensi kata dan kalimat
        """
        issues = []
        sentences = nltk.sent_tokenize(text)

        if len(sentences) > 1:
            # Cek transisi antar kalimat
            transitions = ['first', 'second', 'third', 'finally', 'however', 'therefore',
                          'moreover', 'furthermore', 'consequently', 'additionally']

            for i in range(1, len(sentences)):
                prev_words = set(sentences[i-1].lower().split())
                curr_words = set(sentences[i].lower().split())

                # Cek apakah ada kata penghubung
                has_transition = any(trans in curr_words for trans in transitions)

                # Cek overlap antar kalimat
                overlap = len(prev_words.intersection(curr_words)) / len(prev_words)

                if overlap < 0.1 and not has_transition:
                    issues.append({
                        'sentence': sentences[i][:100] + '...',
                        'issue': 'Kalimat mungkin tidak koheren',
                        'suggestion': 'Tambahkan kata transisi atau perbaiki struktur kalimat'
                    })

        return issues

    def check_eyd(self, text):
        """
        Memeriksa standar EYD (Ejaan Yang Disempurnakan) untuk Bahasa Indonesia
        """
        issues = []

        # Aturan EYD sederhana
        rules = [
            # Penggunaan huruf kapital
            (r'(?<=\. )([a-z])', 'Huruf kapital setelah titik'),
            # Penggunaan tanda baca
            (r'(,)([A-Za-z])', 'Spasi setelah tanda koma'),
            (r'(\.)([A-Za-z])', 'Spasi setelah tanda titik'),
            # Preposisi di, ke, dari
            (r'\b(di|ke|dari)([A-Z]|[a-z])', 'Penulisan preposisi yang salah'),
        ]

        for pattern, message in rules:
            matches = re.finditer(pattern, text)
            for match in matches:
                issues.append({
                    'issue': message,
                    'context': text[max(0, match.start()-20):min(len(text), match.end()+20)],
                    'suggestion': 'Perbaiki sesuai aturan EYD'
                })

        return issues

