    print("✅ Deteksi dan koreksi EYD")
    print("✅ Deteksi format penulisan")
    print("✅ Analisis koherensi teks")
    print("✅ Deteksi similarity dan parafrase")
    print("✅ Analisis penggunaan AI")
    print("✅ Analisis statistik teks")
    print("="*80)

    # Upload file
    file_path = upload_file()
    if not file_path:
        print("❌ Tidak ada file yang diupload")
        return

    # Baca file
    print("\n📖 Membaca file...")
    original_text = read_file(file_path)

    if not original_text:
        print("❌ Gagal membaca file")
        return

    print(f"✅ Teks berhasil dibaca. Total karakter: {len(original_text)}")

    # Inisialisasi tools
    corrector = TextCorrector()
    similarity = SimilarityDetector()
    ai_detector = AIDetector()

    # Analisis statistik
    print("\n📊 Analisis statistik teks...")
    stats = analyze_statistics(original_text)

    # Deteksi typo
    print("\n🔍 Memeriksa typo...")
    text_typo, typo_fixes = corrector.check_typos(original_text)

    # Deteksi grammar
    print("\n📝 Memeriksa grammar...")
    text_grammar, grammar_fixes = corrector.check_grammar(text_typo)

    # Deteksi EYD
    print("\n📝 Memeriksa EYD...")
    eyd_issues = corrector.check_eyd(text_grammar)

    # Deteksi formatting
    print("\n📝 Memeriksa formatting...")
    format_issues = corrector.check_formatting(text_grammar)

    # Deteksi koherensi
    print("\n📝 Memeriksa koherensi...")
    coherence_issues = corrector.check_coherence(text_grammar)

    # Gabungkan semua isu
    all_issues = typo_fixes + grammar_fixes + eyd_issues + format_issues + coherence_issues

    # Deteksi similarity
    print("\n🔍 Mendeteksi similarity...")
    similar_pairs = similarity.check_similarity(text_grammar)

    # Parafrase kalimat yang mirip
