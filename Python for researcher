    # Deteksi AI
    print("\n🤖 Menganalisis penggunaan AI...")
    ai_analysis = ai_detector.detect_ai_usage(original_text)

    # Generate report
    print("\n📄 Membuat laporan...")
    output_file = generate_report(
        original_text,
        paraphrased_text,
        all_issues,
        all_issues,
        stats,
        ai_analysis,
        similar_pairs
    )

    print(f"\n✅ Laporan berhasil dibuat: {output_file}")
