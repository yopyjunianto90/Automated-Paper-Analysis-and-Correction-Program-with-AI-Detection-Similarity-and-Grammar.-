def read_pdf(file_path):
    """
    Membaca file PDF dan mengekstrak teks
    """
    try:
        text = ""
        with pdfplumber.open(file_path) as pdf:
            for page in pdf.pages:
                text += page.extract_text() + "\n"
        return text
    except Exception as e:
        print(f"❌ Error membaca PDF: {e}")
        return None

def read_docx(file_path):
    """
    Membaca file DOCX dan mengekstrak teks
    """
    try:
        text = docx2txt.process(file_path)
        return text
    except Exception as e:
        print(f"❌ Error membaca DOCX: {e}")
        return None

def read_file(file_path):
    """
    Membaca file berdasarkan ekstensi
    """
    if file_path.endswith('.pdf'):
        return read_pdf(file_path)
    elif file_path.endswith('.docx') or file_path.endswith('.doc'):
        return read_docx(file_path)
    else:
        print("❌ Format file tidak didukung. Gunakan PDF atau DOCX")
        return None

