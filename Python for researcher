# 3. FUNGSI DETEKSI SIMILARITY DAN PARAPHRASE
# ============================================

class SimilarityDetector:
    def __init__(self):
        """
        Inisialisasi model untuk deteksi similarity dan parafrase
        """
        print("🔧 Menginisialisasi model similarity...")
        self.sentence_model = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')
        self.paraphraser = pipeline("text2text-generation", model="t5-small")
        print("✅ Model similarity siap digunakan")

    def check_similarity(self, text, threshold=0.7):
        """
        Mendeteksi kalimat yang memiliki similarity tinggi
        """
        sentences = nltk.sent_tokenize(text)
        similar_pairs = []

        if len(sentences) > 1:
            embeddings = self.sentence_model.encode(sentences, convert_to_tensor=True)

            for i in range(len(sentences)):
                for j in range(i+1, len(sentences)):
                    similarity = util.pytorch_cos_sim(embeddings[i], embeddings[j])
                    if similarity > threshold:
                        similar_pairs.append({
                            'sentence1': sentences[i],
                            'sentence2': sentences[j],
                            'similarity_score': float(similarity)
                        })

        return similar_pairs

    def paraphrase_text(self, text):
        """
        Membuat parafrase dari teks yang mirip
        """
        try:
            # Batasi panjang teks
            if len(text) > 200:
                text = text[:200]

            # Generate parafrase
            paraphrase = self.paraphraser(
                f"paraphrase: {text}",
                max_length=200,
                num_return_sequences=1
            )

            return paraphrase[0]['generated_text']
        except Exception as e:
            print(f"❌ Error parafrase: {e}")
            return text

